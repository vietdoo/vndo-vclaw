# ── Vclaw Platform Configuration ────────────────────────────
# Copy this file to .env and fill in your values

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# LLM Providers (JSON array)
VCLAW_LLM_PROVIDERS=[{"name":"openai","api_key":"sk-...","model":"gpt-4o-mini","base_url":"https://api.openai.com/v1"}]

# Environment overrides (uncomment to customize)
# VCLAW_ENVIRONMENT=production
# VCLAW_DEBUG=false
# VCLAW_EVENT_BUS_BACKEND=kafka
# VCLAW_PERSISTENCE_BACKEND=postgres
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# POSTGRES_DSN=postgresql://vclaw:vclaw@postgres:5432/vclaw
# REDIS_URL=redis://redis:6379/0
