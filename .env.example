# Application
APP_NAME=vndo-vclaw
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false

# API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["*"]

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vclaw
POSTGRES_PASSWORD=vclaw_secret
POSTGRES_DB=vclaw_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_WORKFLOW_EVENTS=workflow-events
KAFKA_TOPIC_SYSTEM_LOGS=system-logs
KAFKA_CONSUMER_GROUP=vclaw-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
