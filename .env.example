# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── API Server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Optional: set for webhook mode, omit for long-polling (local dev)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ── Redis (Event Bus) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_PREFIX=vclaw:stream
REDIS_CONSUMER_GROUP=vclaw-workers

# ── LLM Providers (set at least one) ──────────────────────────────────────────
# Priority order: first available = used first (cost-optimized)
LLM_PROVIDER_PRIORITY=openrouter_free,anthropic,openai

# OpenRouter (free tier available)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_FREE_MODEL=mistralai/mistral-7b-instruct:free

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenAI (fallback)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Orchestrator ───────────────────────────────────────────────────────────────
ORCH_MAX_CONCURRENT_TASKS=50
ORCH_TASK_TIMEOUT=120
ORCH_IDEMPOTENCY_TTL=86400

# ── Agents ─────────────────────────────────────────────────────────────────────
AGENT_PLUGIN_DIRS=vclaw/agents
AGENT_HEALTH_CHECK_INTERVAL=30

# ── Observability ──────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=vclaw-platform
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
